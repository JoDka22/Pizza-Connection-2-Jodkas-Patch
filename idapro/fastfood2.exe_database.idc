#define UNLOADED_FILE   1
#include <idc.idc>

extern ltf;  // load_type flags

static main(void)
{
  ltf = ARGV.count > 1 ? ARGV[1] : LOADTYPE_DEFAULT;
  // set 'loading idc file' mode
  set_inf_attr(INF_GENFLAGS, INFFL_LOADIDC|get_inf_attr(INF_GENFLAGS));
  GenInfo();     // various settings
  Segments();    // segmentation
  LocalTypes();  // local types
  Patches();     // manual patches
  SegRegs();     // segment register values
  Bytes();       // individual bytes (code,data)
  Functions();   // function definitions
  // clear 'loading idc file' mode
  set_inf_attr(INF_GENFLAGS, ~INFFL_LOADIDC&get_inf_attr(INF_GENFLAGS));
}

//------------------------------------------------------------------------
// General information

static GenInfo(void)
{
  delete_all_segments();   // purge database
  set_processor_type("metapc", SETPROC_USER);
  set_inf_attr(INF_COMPILER, 1);
  set_inf_attr(INF_STRLIT_BREAK, 0xA);
  set_flag(INF_CMTFLG, SCF_ALLCMT, 0);
  set_flag(INF_OUTFLAGS, OFLG_SHOW_VOID, 0);
  set_inf_attr(INF_XREFNUM, 2);
  set_flag(INF_OUTFLAGS, OFLG_SHOW_AUTO, 1);
  set_inf_attr(INF_INDENT, 16);
  set_inf_attr(INF_CMT_INDENT, 40);
  set_inf_attr(INF_MAXREF, 0x10);
  add_default_til("mssdk_win7");
}

//------------------------------------------------------------------------
// Information about segmentation

static Segments(void)
{
  set_selector(0x1, 0x0);
  set_selector(0x2, 0x0);
  set_selector(0x3, 0x0);

  add_segm_ex(0x401000, 0x55C000, 0x1, 1, 3, 2, ADDSEG_NOSREG);
  set_segm_name(0x401000, ".text");
  set_segm_class(0x401000, "CODE");
  SegDefReg(0x401000,"es",0x0);
  SegDefReg(0x401000,"ss",0x0);
  SegDefReg(0x401000,"ds",0x3);
  set_segm_type(0x401000, 2);
  add_segm_ex(0x55C000, 0x55C2E0, 0x2, 1, 3, 2, ADDSEG_NOSREG);
  set_segm_name(0x55C000, ".idata");
  set_segm_class(0x55C000, "DATA");
  SegDefReg(0x55C000,"es",0x0);
  SegDefReg(0x55C000,"ss",0x0);
  SegDefReg(0x55C000,"ds",0x3);
  set_segm_type(0x55C000, 1);
  add_segm_ex(0x55C2E0, 0x563000, 0x2, 1, 3, 2, ADDSEG_NOSREG);
  set_segm_name(0x55C2E0, ".rdata");
  set_segm_class(0x55C2E0, "DATA");
  SegDefReg(0x55C2E0,"es",0x0);
  SegDefReg(0x55C2E0,"ss",0x0);
  SegDefReg(0x55C2E0,"ds",0x3);
  set_segm_type(0x55C2E0, 3);
  add_segm_ex(0x563000, 0x587000, 0x3, 1, 3, 2, ADDSEG_NOSREG);
  set_segm_name(0x563000, ".data");
  set_segm_class(0x563000, "DATA");
  SegDefReg(0x563000,"es",0x0);
  SegDefReg(0x563000,"ss",0x0);
  SegDefReg(0x563000,"ds",0x3);
  set_segm_type(0x563000, 3);
  set_inf_attr(INF_LOW_OFF, 0x401000);
  set_inf_attr(INF_HIGH_OFF, 0x587000);
}

