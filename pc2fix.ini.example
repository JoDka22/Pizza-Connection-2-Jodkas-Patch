[display]
; Experimental city layout: native viewport, unscaled right/bottom UI.
; Opt in only in a separate game copy. See docs/WIDESCREEN_DE.md for tested scope.
Widescreen=0
; Surface-only diagnostic mode when Widescreen=0; keeps original viewport/UI.
; Both switches default to disabled. Widescreen=1 includes the surface change.
RenderProbe=0
Width=1920
Height=1080
